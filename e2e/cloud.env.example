# Cloud setup automation settings. Copy to cloud.env (git-ignored) and edit:
#   cp cloud.env.example cloud.env
# No passwords or tokens go here - you sign in yourself in the Chrome window.

# ---------- GCP project and service account (01, 02) ----------
GCP_PROJECT_ID=concrete-detection-7
SA_NAME=Empowerinnovate-SA
SA_ID=empowerinnovate-sa
SA_DESCRIPTION=CI/CD service account for the cluster pipeline

# Project roles, comma-separated, exactly as the console role picker names them.
# CI/CD account (as in docScreenshots/3-assign-role.png):
SA_ROLES=Owner,Project IAM Admin,Service Account Admin,Service Account Key Admin,Service Usage Admin
# App account instead (docScreenshots/8-app-specific-sa.png):
# SA_ROLES=Compute Engine Service Agent,Container Registry Service Agent,DNS Administrator,Kubernetes Engine Service Agent,Storage Admin

# Where the key JSON and its base64 copy are written (relative to e2e/).
# SECRETS_DIR=.secrets

# ---------- GitHub (03, 04) ----------
GITHUB_REPO=EmpowerInnovate/HelmCrackDetetion

# 03: repository secret that receives the base64 key. Leave empty to skip step 03.
# Use the secret name your Cluster.yaml reads, e.g. GCP_SA_KEY.
GITHUB_SECRET_NAME=

# 04: the "Kubernetes Cluster Provisioning" workflow and the values to choose.
CLUSTER_WORKFLOW_FILE=Cluster.yaml
# JSON: key = input id from the workflow file, or part of the input's label; value to set.
# "@key_base64" puts the base64 key from step 02 into that input.
CLUSTER_WORKFLOW_INPUTS={"cloud provider":"gcp","apply or destroy":"apply"}
# Wait for the run to finish and fail the test if it does not succeed (1/0).
WAIT_FOR_CLUSTER=1
CLUSTER_TIMEOUT_MIN=45

# ---------- Browser ----------
# Chrome used for the run. Its own profile keeps you signed in between runs.
# CHROME_PATH=/usr/bin/google-chrome
# CHROME_PROFILE_DIR=~/.cache/concrete-cloud-chrome
# CDP_PORT=9222
# Minutes to wait for you to sign in when a login page shows up.
# LOGIN_TIMEOUT_MIN=10
