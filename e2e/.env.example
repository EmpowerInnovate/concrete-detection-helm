# Copy to .env (git-ignored) and fill in:  cp .env.example .env
# Used by `npm run deploy*`. No GitHub password here - you sign in by hand when asked.

# Which cluster you created: gke | eks | aks | do
DEPLOY_PROVIDER=gke
# deploy | uninstall (uninstall exists only for eks and aks)
DEPLOY_ACTION=deploy

# Repo that holds the MAHESH_DEPLOY-* workflows
GITHUB_REPO=EmpowerInnovate/concrete-detection-helm

CLUSTER_NAME=crack-detection-cluster
# Docker image tag: "auto" = latest released tag
IMAGE_TAG=auto
# letsencrypt | letsencrypt-staging | mkcert | none
TLS_MODE=letsencrypt
# Leave commented to use each workflow's default domain
# (gke: maheshconcretegallery.online, eks: crackdetectioneks.online,
#  aks: crackdetectionaks.online, do: crackdetectiondo.online).
# Set it empty (DOMAIN=) to serve on <ip>.sslip.io instead.
# DOMAIN=

# Wait for the run, fail unless it succeeds, then check the live app (true/false)
WAIT_FOR_DEPLOY=true
DEPLOY_TIMEOUT_MIN=40

# ---------- gke ----------
GCP_PROJECT_ID=
GCP_CLUSTER_ZONE=us-central1-a
# Service account key: the JSON file or its single-line base64 copy
GCP_SA_KEY_FILE=~/keys/empowerinnovate-sa-key.json.b64

# ---------- eks ----------
AWS_REGION=us-east-1
# Leave blank to use the repo secrets AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# eks/aks: build new images from this commit (true) or deploy IMAGE_TAG (false)
BUILD_IMAGES=true

# ---------- aks ----------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
# Leave blank to use the repo secrets AZURE_CLIENT_ID / AZURE_CLIENT_SECRET
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Blank = looked up from the cluster name
AKS_RESOURCE_GROUP=
AKS_DNS_LABEL=crack-detection-mahesh

# ---------- do ----------
DO_TOKEN=
